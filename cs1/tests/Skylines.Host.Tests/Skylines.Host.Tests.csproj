<Project Sdk="Microsoft.NET.Sdk">
  <!-- Skylines.Host is net35 and needs the game's assemblies; the Unity-free launch logic is compiled in directly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Skylines.Host\Process\LaunchConfig.cs" Link="LaunchConfig.cs" />
    <Compile Include="..\..\src\Skylines.Host\Process\SaveMatch.cs" Link="SaveMatch.cs" />
    <Compile Include="..\..\src\Skylines.Host\Process\AutoloadTarget.cs" Link="AutoloadTarget.cs" />
    <Compile Include="..\..\src\Skylines.Host\Process\CompanionProcess.cs" Link="CompanionProcess.cs" />
    <Compile Include="..\..\src\Skylines.Host\Rendering\MeshSplit.cs" Link="MeshSplit.cs" />
    <Compile Include="..\..\src\Skylines.Host\Overlay\SharedOverlayReader.cs" Link="SharedOverlayReader.cs" />
    <Compile Include="..\..\src\Skylines.Host\Overlay\OverlayMode.cs" Link="OverlayMode.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
